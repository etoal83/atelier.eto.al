---
import Logo from './Logo.astro';
import Sitename from './Sitename.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
---

<header>
  <a href="/" class="link-home">
    <div class="link-home-container">
      <Logo />
      <Sitename />
    </div>
  </a>
  <div class="theme-switch-container">
    <ThemeSwitch />
  </div>
</header>

<style>
  header {
    display: inline-flex;
    align-items: center;
    width: 100%;
    height: 80px;
  }

  a.link-home {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .link-home-container {
    display: inline-flex;
    align-items: center;
    column-gap: 14px;
  }
  .theme-switch-container {
    display: inline-flex;
    margin-left: auto;
  }
</style>