---
import '../styles/global.css';
---

<button id="themeSwitch" aria-label="Toggle dark theme">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24px">
    <path class="ri-sun-line icon-sun" fill-rule="evenodd" d="M12 18C8.68629 18 6 15.3137 6 12C6 8.68629 8.68629 6 12 6C15.3137 6 18 8.68629 18 12C18 15.3137 15.3137 18 12 18ZM12 16C14.2091 16 16 14.2091 16 12C16 9.79086 14.2091 8 12 8C9.79086 8 8 9.79086 8 12C8 14.2091 9.79086 16 12 16ZM11 1H13V4H11V1ZM11 20H13V23H11V20ZM3.51472 4.92893L4.92893 3.51472L7.05025 5.63604L5.63604 7.05025L3.51472 4.92893ZM16.9497 18.364L18.364 16.9497L20.4853 19.0711L19.0711 20.4853L16.9497 18.364ZM19.0711 3.51472L20.4853 4.92893L18.364 7.05025L16.9497 5.63604L19.0711 3.51472ZM5.63604 16.9497L7.05025 18.364L4.92893 20.4853L3.51472 19.0711L5.63604 16.9497ZM23 11V13H20V11H23ZM4 11V13H1V11H4Z"></path>
    <path class="ri-moon-clear-fill icon-moon" fill-rule="evenodd" d="M9.8216 2.23796C9.29417 3.38265 9 4.65697 9 6C9 10.9706 13.0294 15 18 15C19.343 15 20.6174 14.7058 21.762 14.1784C20.7678 18.6537 16.7747 22 12 22C6.47715 22 2 17.5228 2 12C2 7.22532 5.3463 3.23221 9.8216 2.23796ZM18.1642 2.29104L19 2.5V3.5L18.1642 3.70896C17.4476 3.8881 16.8881 4.4476 16.709 5.16417L16.5 6H15.5L15.291 5.16417C15.1119 4.4476 14.5524 3.8881 13.8358 3.70896L13 3.5V2.5L13.8358 2.29104C14.5524 2.1119 15.1119 1.5524 15.291 0.835829L15.5 0H16.5L16.709 0.835829C16.8881 1.5524 17.4476 2.1119 18.1642 2.29104ZM23.1642 7.29104L24 7.5V8.5L23.1642 8.70896C22.4476 8.8881 21.8881 9.4476 21.709 10.1642L21.5 11H20.5L20.291 10.1642C20.1119 9.4476 19.5524 8.8881 18.8358 8.70896L18 8.5V7.5L18.8358 7.29104C19.5524 7.1119 20.1119 6.5524 20.291 5.83583L20.5 5H21.5L21.709 5.83583C21.8881 6.5524 22.4476 7.1119 23.1642 7.29104Z"></path>
  </svg>
</button>

<style>
  #themeSwitch {
    border: 0;
    background: none;
    width: 36px;
    height: 36px;
    border-radius: 4px;
  }

  :global([data-theme='light']) .icon-sun {
    fill: var(--color-accent-sub);
  }
  :global([data-theme='light']) .icon-moon {
    fill: transparent;
  }

  :global([data-theme='dark']) .icon-sun {
    fill: transparent;
  }
  :global([data-theme='dark']) .icon-moon {
    fill: var(--color-primary);
  }
</style>

<script is:inline>
  const theme = (() => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      return 'dark';
    }
      return 'light';
  })();

  if (document.body.dataset.theme === undefined) {
    document.body.dataset.theme = theme;
  }
  if (theme === 'dark') {
    document.body.dataset.theme = 'dark';
  } else {
    document.body.dataset.theme = 'light';
  }

  window.localStorage.setItem('theme', theme);

  const handleToggleClick = () => {
    const currentTheme = document.body.dataset.theme;
    const targetTheme = currentTheme === 'dark' ? 'light' : 'dark';

    document.body.dataset.theme = targetTheme;
    localStorage.setItem("theme", targetTheme);
  }

  document.getElementById("themeSwitch").addEventListener("click", handleToggleClick);
</script>