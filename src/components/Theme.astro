<style is:global>
:root {
  /* light mode palette */
  --bg-color: #F0F2F6;
  --surface-color: #DFE3EA;
  --text-color: #2D3142;
  --primary-color: #4062BB;
  --secondary-color: #52A49A;
  --accent-color: #FFBF3C;
  --success-color: #4CAF50;
  --warning-color: #FF9800;
  --error-color: #E53935;
  --info-color: #2196F3;
}

@media (prefers-color-scheme: dark) {
  :root {
    /* dark mode palette */
    --bg-color: #1A1D2A;
    --surface-color: #262B3D;
    --text-color: #E2E4EC;
    --primary-color: #7087DC;
    --secondary-color: #6DBEAC;
    --accent-color: #FFD566;
    --success-color: #66BB6A;
    --warning-color: #FFA726;
    --error-color: #EF5350;
    --info-color: #42A5F5;
  }
}</style>